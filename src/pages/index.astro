---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Blog yazılarını çek ve sırala
const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Projeleri çek ve sırala
const allProjects = await getCollection('projects');
const sortedProjects = allProjects
  .filter((p) => p.data.featured !== false)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const projectCategories = [
  'Tümü',
  ...Array.from(new Set(sortedProjects.map((p) => p.data.category))),
];

const stackGroups = [
  {
    title: 'Diller & Temel',
    items: [
      { name: 'Python', icon: '🐍', desc: 'Otomasyon & Scripting' },
      { name: 'Java', icon: '☕', desc: 'Bukkit/Spigot & Android' },
      { name: 'JavaScript / TS', icon: '⚡', desc: 'Modern Web Arayüzleri' },
    ],
  },
  {
    title: 'Framework & Veritabanı',
    items: [
      { name: 'Astro & Next.js', icon: '🚀', desc: 'Performanslı Web Mimarisi' },
      { name: 'Tailwind CSS', icon: '🎨', desc: 'Modern & Akıcı UI' },
      { name: 'MySQL', icon: '🗄️', desc: 'İlişkisel Veritabanı' },
    ],
  },
  {
    title: 'Uzmanlık Alanları',
    items: [
      { name: 'Computer Vision', icon: '👁️', desc: 'Tarayıcıda El & Yüz Takibi' },
      { name: 'Discord API', icon: '🤖', desc: 'Bot & Topluluk Otomasyonu' },
      { name: 'Bukkit / Spigot', icon: '⚙️', desc: 'Minecraft Sunucu Eklentileri' },
      { name: 'Git & GitHub', icon: '🐙', desc: 'Versiyon Kontrolü & CI/CD' },
    ],
  },
];
---

<BaseLayout>
  <!-- Arka Plan Atmosfer Işıkları (Ambient Glow) -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div
      class="absolute -top-40 right-10 w-[500px] h-[500px] bg-copper/5 blur-[120px] rounded-full"
    >
    </div>
    <div
      class="absolute top-[40%] left-[-100px] w-[450px] h-[450px] bg-slate/5 blur-[140px] rounded-full"
    >
    </div>
  </div>

  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-[380px_1fr] min-h-screen">
    <!-- SOL SABİT PANEL (Masaüstü) -->
    <aside
      class="lg:sticky lg:top-0 lg:h-screen p-8 lg:p-14 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-line bg-bg/90 backdrop-blur-md"
    >
      <div>
        <!-- Marka / Logo -->
        <div class="flex items-center justify-between">
          <a
            href="/"
            class="font-serif text-2xl font-semibold tracking-wide hover:opacity-90 transition-opacity"
          >
            E.<span class="text-copper">Çetin_</span>
          </a>
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 text-xs rounded-full border border-copper/30 bg-copper/10 text-copper font-medium shadow-[0_0_12px_rgba(198,132,79,0.15)]"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-copper animate-pulse"></span>
            Valtura Kurucusu
          </span>
        </div>

        <!-- İsim & Kısa Tanıtım -->
        <div class="mt-12">
          <h1 class="font-serif text-3xl font-medium leading-tight text-ink">
            Mehmet Enes Çetin
          </h1>
          <p class="mt-3 text-sm text-ink-muted leading-relaxed">
            Python, full-stack web geliştirme ve yapay zeka otomasyonları. Fikirleri çalışan, performanslı ürünlere dönüştürüyorum.
          </p>
        </div>

        <!-- Navigasyon -->
        <nav class="mt-10 flex flex-col gap-1 text-sm font-medium">
          <a
            href="#about"
            class="py-2.5 flex justify-between items-center text-ink-muted hover:text-ink hover:translate-x-1 border-t border-line transition-all group"
          >
            <span class="group-hover:text-copper transition-colors">01. Kim miyim?</span>
            <span class="text-xs text-ink-faint">Hakkımda</span>
          </a>
          <a
            href="#stack"
            class="py-2.5 flex justify-between items-center text-ink-muted hover:text-ink hover:translate-x-1 border-t border-line transition-all group"
          >
            <span class="group-hover:text-copper transition-colors">02. Kullandığım Araçlar</span>
            <span class="text-xs text-ink-faint">Stack</span>
          </a>
          <a
            href="#projects"
            class="py-2.5 flex justify-between items-center text-ink-muted hover:text-ink hover:translate-x-1 border-t border-line transition-all group"
          >
            <span class="group-hover:text-copper transition-colors">03. Geliştirdiklerim</span>
            <span class="text-xs text-ink-faint">Projeler</span>
          </a>
          <a
            href="#blog"
            class="py-2.5 flex justify-between items-center text-ink-muted hover:text-ink hover:translate-x-1 border-t border-line transition-all group"
          >
            <span class="group-hover:text-copper transition-colors">04. Yazılar</span>
            <span class="text-xs text-ink-faint">Blog</span>
          </a>
          <a
            href="#connect"
            class="py-2.5 flex justify-between items-center text-ink-muted hover:text-ink hover:translate-x-1 border-t border-b border-line transition-all group"
          >
            <span class="group-hover:text-copper transition-colors">05. Bağlantıya Geç</span>
            <span class="text-xs text-ink-faint">İletişim</span>
          </a>
        </nav>
      </div>

      <!-- Alt Bilgi & Sosyal Bağlantılar -->
      <div class="mt-12 pt-6 border-t border-line flex flex-col gap-4">
        <div class="flex gap-4 text-ink-muted text-sm font-mono">
          <a
            href="https://github.com/darkknightlag"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-copper transition-colors">GitHub</a
          >
          <a
            href="https://www.instagram.com/mehmet.enes.cetin"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-copper transition-colors">Instagram</a
          >
          <a
            href="https://play.google.com/store/apps/developer?id=MehmetEnes"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-copper transition-colors">Play Store</a
          >
        </div>
        <p class="text-xs text-ink-faint">
          © {new Date().getFullYear()} Mehmet Enes Çetin. Tüm hakları saklıdır.
        </p>
      </div>
    </aside>

    <!-- SAĞ AKIŞ PANELİ -->
    <main class="divide-y divide-line">
      <!-- HERO BÖLÜMÜ -->
      <section class="p-8 lg:p-16 max-w-4xl pt-16 lg:pt-24">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-line bg-bg-elevated/50 text-xs font-mono text-slate mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Yeni Projelere &amp; İş Birliklerine Açık
        </div>

        <h2
          class="font-serif text-4xl sm:text-6xl lg:text-7xl font-medium tracking-tight leading-[1.08] text-ink"
        >
          Merhaba,<br />
          ben <span class="text-transparent bg-clip-text bg-gradient-to-r from-ink via-ink to-copper">Enes.</span>
        </h2>

        <p class="mt-6 text-lg text-ink-muted leading-relaxed max-w-2xl font-light">
          Otomasyon araçlarından Discord botlarına, modern web platformlarından Minecraft sunucu sistemlerine kadar geniş bir yelpazede yüksek performanslı dijital ürünler inşa ediyorum.
        </p>

        <!-- Eylem Butonları -->
        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a
            href="#projects"
            class="px-6 py-3 bg-copper hover:bg-copper-light text-bg font-semibold text-sm rounded shadow-[0_4px_16px_rgba(198,132,79,0.25)] transition-all hover:-translate-y-0.5 inline-flex items-center gap-2"
          >
            Projelerimi İncele →
          </a>
          <a
            href="/blog"
            class="px-6 py-3 border border-line hover:border-copper/80 bg-bg-elevated/30 hover:bg-bg-elevated text-ink hover:text-copper font-medium text-sm rounded transition-all inline-flex items-center gap-2"
          >
            Blog &amp; Makaleler ↗
          </a>
          <a
            href="#connect"
            class="px-6 py-3 border border-transparent hover:border-line text-ink-muted hover:text-ink font-medium text-sm rounded transition-all"
          >
            İletişime Geç
          </a>
        </div>

        <!-- İstatistik Sayacı -->
        <div class="mt-16 pt-8 border-t border-line grid grid-cols-3 gap-6">
          <div class="p-4 rounded border border-line/40 bg-bg-elevated/20">
            <b class="font-serif text-3xl font-medium text-ink block">3+</b>
            <span class="text-xs text-ink-faint mt-1 block">Yıllık Geliştirme Deneyimi</span>
          </div>
          <div class="p-4 rounded border border-line/40 bg-bg-elevated/20">
            <b class="font-serif text-3xl font-medium text-ink block">6+</b>
            <span class="text-xs text-ink-faint mt-1 block">Aktif Proje Ekosistemi</span>
          </div>
          <div class="p-4 rounded border border-copper/30 bg-copper/5">
            <b class="font-serif text-3xl font-medium text-copper block">Valtura</b>
            <span class="text-xs text-copper/80 mt-1 block">Geliştirici Birliği</span>
          </div>
        </div>
      </section>

      <!-- 01. KİM MİYİM? -->
      <section id="about" class="p-8 lg:p-16 max-w-4xl scroll-mt-6">
        <div class="flex items-baseline gap-3 mb-8">
          <span class="font-serif italic text-copper text-lg">01</span>
          <h2 class="font-serif text-3xl text-ink font-medium">Kim miyim?</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
          <div class="p-5 rounded-lg border border-line bg-bg-elevated/30">
            <div class="text-2xl mb-3">⚡</div>
            <h3 class="font-serif font-medium text-ink text-base mb-1">Full-Stack Vizyon</h3>
            <p class="text-xs text-ink-muted leading-relaxed">
              Kullanıcı arayüzünden veritabanına, sunucu mimarisinden otomasyon katmanına kadar uçtan uca düşünürüm.
            </p>
          </div>
          <div class="p-5 rounded-lg border border-line bg-bg-elevated/30">
            <div class="text-2xl mb-3">🛡️</div>
            <h3 class="font-serif font-medium text-ink text-base mb-1">Valtura Ekosistemi</h3>
            <p class="text-xs text-ink-muted leading-relaxed">
              2025'te kurduğum geliştirici birliği çatısı altında bağımsız yazılım ürünleri ve bot ekosistemleri üretiyorum.
            </p>
          </div>
          <div class="p-5 rounded-lg border border-line bg-bg-elevated/30">
            <div class="text-2xl mb-3">🧠</div>
            <h3 class="font-serif font-medium text-ink text-base mb-1">Modern Teknolojiler</h3>
            <p class="text-xs text-ink-muted leading-relaxed">
              Görüntü işleme, jest tanıma, istemci taraflı yapay zeka ve Python ile zaman kazandıran otomasyon araçları.
            </p>
          </div>
        </div>

        <div class="space-y-4 text-ink-muted text-base leading-relaxed font-light">
          <p>
            Küçüklüğümden beri bilgisayarlara olan merakım zamanla <strong class="text-ink font-medium">özgün projelere</strong> dönüştü. Şu an kendi çatım olan <strong class="text-copper font-medium">Valtura</strong> altında otomasyon araçlarından Discord botlarına, modern web arayüzlerinden Minecraft plugin geliştirmeye kadar geniş bir yelpazede çalışıyorum.
          </p>
          <p>
            Her gün yeni bir şeyler öğrenmek ve bunu kullanışlı, şık bir ürüne dönüştürmek temel ilkem. Backend'den frontend'e, mobil uygulamalardan oyun sunucu sistemlerine kadar <strong class="text-ink font-medium">tam yığın</strong> düşünen bir geliştiriciyim.
          </p>
        </div>
      </section>

      <!-- 02. KULLANDIĞIM ARAÇLAR -->
      <section id="stack" class="p-8 lg:p-16 max-w-4xl scroll-mt-6">
        <div class="flex items-baseline gap-3 mb-8">
          <span class="font-serif italic text-copper text-lg">02</span>
          <h2 class="font-serif text-3xl text-ink font-medium">Kullandığım Araçlar</h2>
        </div>

        <div class="space-y-6">
          {
            stackGroups.map((group) => (
              <div>
                <h3 class="text-xs font-mono uppercase tracking-wider text-slate mb-3">
                  {group.title}
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  {group.items.map((item) => (
                    <div class="p-4 rounded-lg border border-line bg-bg-elevated/40 hover:border-copper/70 hover:bg-bg-elevated/80 transition-all group flex items-start gap-3">
                      <span class="text-2xl">{item.icon}</span>
                      <div>
                        <div class="font-medium text-sm text-ink group-hover:text-copper transition-colors">
                          {item.name}
                        </div>
                        <div class="text-xs text-ink-faint mt-0.5">{item.desc}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 03. GELİŞTİRDİKLERİM (PROJELER) -->
      <section id="projects" class="p-8 lg:p-16 max-w-4xl scroll-mt-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 mb-8">
          <div class="flex items-baseline gap-3">
            <span class="font-serif italic text-copper text-lg">03</span>
            <h2 class="font-serif text-3xl text-ink font-medium">Geliştirdiklerim</h2>
          </div>
          <span class="text-xs font-mono text-ink-faint">
            Admin panelinden yönetilebilir portfolyo
          </span>
        </div>

        <!-- Kategori Filtre Hapları -->
        <div class="flex flex-wrap gap-2 mb-8" id="project-filters">
          {
            projectCategories.map((cat, idx) => (
              <button
                type="button"
                data-filter={cat}
                class={`proj-filter-btn px-3 py-1.5 text-xs rounded border transition-all ${
                  idx === 0
                    ? 'bg-copper text-bg border-copper font-medium shadow-[0_2px_10px_rgba(198,132,79,0.2)]'
                    : 'border-line text-ink-muted hover:border-copper/60 hover:text-ink'
                }`}
              >
                {cat}
              </button>
            ))
          }
        </div>

        <!-- Proje Kartları -->
        <div class="grid grid-cols-1 gap-6" id="projects-list">
          {
            sortedProjects.map((proj) => (
              <div
                data-category={proj.data.category}
                class="project-card p-6 rounded-xl border border-line bg-bg-elevated/30 hover:border-copper/80 hover:bg-bg-elevated/60 transition-all group relative overflow-hidden"
              >
                <div class="flex flex-col sm:flex-row justify-between sm:items-start gap-2">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-mono uppercase tracking-wider text-copper">
                        {proj.data.tagline}
                      </span>
                      <span class="text-ink-faint">•</span>
                      <span class="text-xs px-2 py-0.5 rounded-full border border-line bg-bg-elevated text-ink-muted">
                        {proj.data.status}
                      </span>
                    </div>
                    <h3 class="font-serif text-2xl text-ink font-medium group-hover:text-copper transition-colors">
                      {proj.data.title}
                    </h3>
                  </div>

                  <span class="text-xs font-mono text-ink-faint px-2.5 py-1 border border-line rounded self-start">
                    {proj.data.year}
                  </span>
                </div>

                <p class="mt-3 text-sm text-ink-muted leading-relaxed font-light">
                  {proj.data.description}
                </p>

                <div class="mt-6 pt-4 border-t border-line/60 flex flex-wrap items-center justify-between gap-4">
                  <!-- Etiketler -->
                  <div class="flex flex-wrap gap-1.5">
                    {proj.data.tags.map((tag) => (
                      <span class="text-xs px-2.5 py-0.5 rounded bg-line/40 text-ink-muted">
                        #{tag}
                      </span>
                    ))}
                  </div>

                  <!-- Bağlantılar -->
                  <div class="flex items-center gap-3 text-xs font-medium">
                    {proj.data.github && (
                      <a
                        href={proj.data.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-ink-muted hover:text-copper transition-colors flex items-center gap-1"
                      >
                        GitHub ↗
                      </a>
                    )}
                    {proj.data.link && (
                      <a
                        href={proj.data.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-3 py-1.5 bg-copper/10 hover:bg-copper text-copper hover:text-bg border border-copper/30 rounded transition-all flex items-center gap-1 font-semibold"
                      >
                        Canlı Gör ↗
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- 04. SON YAZILAR (BLOG) -->
      <section id="blog" class="p-8 lg:p-16 max-w-4xl scroll-mt-6">
        <div class="flex justify-between items-baseline mb-8">
          <div class="flex items-baseline gap-3">
            <span class="font-serif italic text-copper text-lg">04</span>
            <h2 class="font-serif text-3xl text-ink font-medium">Son Yazılar</h2>
          </div>
          <a
            href="/blog"
            class="text-sm text-copper hover:text-copper-light hover:underline flex items-center gap-1 font-medium"
          >
            Tüm Blog Yazılarını Gör →
          </a>
        </div>

        {
          publishedPosts.length === 0 ? (
            <div class="p-8 border border-line rounded text-center text-ink-muted text-sm">
              Henüz yayınlanmış bir yazı bulunmuyor. /admin üzerinden ilk yazınızı ekleyebilirsiniz.
            </div>
          ) : (
            <div class="space-y-4">
              {publishedPosts.map((post) => (
                <a
                  href={`/blog/${post.id}/`}
                  class="p-6 rounded-xl border border-line bg-bg-elevated/20 hover:border-copper/70 hover:bg-bg-elevated/50 transition-all block group"
                >
                  <div class="flex items-center gap-3 text-xs text-ink-faint mb-2">
                    <span class="text-copper font-medium">{post.data.category}</span>
                    <span>•</span>
                    <span>
                      {post.data.date.toLocaleDateString('tr-TR', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      })}
                    </span>
                  </div>
                  <h3 class="font-serif text-xl font-medium text-ink group-hover:text-copper transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="mt-2 text-sm text-ink-muted line-clamp-2 font-light leading-relaxed">
                    {post.data.description}
                  </p>
                </a>
              ))}
            </div>
          )
        }
      </section>

      <!-- 05. BAĞLANTIYA GEÇ (İLETİŞİM) -->
      <section id="connect" class="p-8 lg:p-16 max-w-4xl scroll-mt-6">
        <div class="flex items-baseline gap-3 mb-8">
          <span class="font-serif italic text-copper text-lg">05</span>
          <h2 class="font-serif text-3xl text-ink font-medium">Bağlantıya Geç</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a
            href="https://github.com/darkknightlag"
            target="_blank"
            rel="noopener noreferrer"
            class="p-5 border border-line rounded-lg bg-bg-elevated/20 hover:border-copper hover:bg-bg-elevated/60 transition-all flex items-center justify-between group"
          >
            <div>
              <span class="text-xs text-ink-faint block uppercase font-mono">GitHub</span>
              <span class="text-ink font-medium group-hover:text-copper transition-colors"
                >darkknightlag</span
              >
            </div>
            <span class="text-2xl opacity-60 group-hover:opacity-100 transition-opacity">🐙</span>
          </a>

          <a
            href="https://www.instagram.com/mehmet.enes.cetin"
            target="_blank"
            rel="noopener noreferrer"
            class="p-5 border border-line rounded-lg bg-bg-elevated/20 hover:border-copper hover:bg-bg-elevated/60 transition-all flex items-center justify-between group"
          >
            <div>
              <span class="text-xs text-ink-faint block uppercase font-mono">Instagram</span>
              <span class="text-ink font-medium group-hover:text-copper transition-colors"
                >mehmet.enes.cetin</span
              >
            </div>
            <span class="text-2xl opacity-60 group-hover:opacity-100 transition-opacity">📸</span>
          </a>

          <a
            href="https://play.google.com/store/apps/developer?id=MehmetEnes"
            target="_blank"
            rel="noopener noreferrer"
            class="p-5 border border-line rounded-lg bg-bg-elevated/20 hover:border-copper hover:bg-bg-elevated/60 transition-all flex items-center justify-between group"
          >
            <div>
              <span class="text-xs text-ink-faint block uppercase font-mono">Google Play</span>
              <span class="text-ink font-medium group-hover:text-copper transition-colors"
                >MehmetEnes</span
              >
            </div>
            <span class="text-2xl opacity-60 group-hover:opacity-100 transition-opacity">📱</span>
          </a>

          <a
            href="mailto:enescetinmehmet14@gmail.com"
            class="p-5 border border-line rounded-lg bg-bg-elevated/20 hover:border-copper hover:bg-bg-elevated/60 transition-all flex items-center justify-between group"
          >
            <div>
              <span class="text-xs text-ink-faint block uppercase font-mono">E-Posta</span>
              <span class="text-ink font-medium text-sm truncate group-hover:text-copper transition-colors"
                >enescetinmehmet14@gmail.com</span
              >
            </div>
            <span class="text-2xl opacity-60 group-hover:opacity-100 transition-opacity">✉️</span>
          </a>
        </div>

        <div class="mt-8 p-8 border border-copper/30 rounded-xl bg-copper/5">
          <p class="text-sm text-ink-muted leading-relaxed">
            Bir proje fikriniz mi var, iş birliği mi yapmak istiyorsunuz yoksa sadece merhaba mı demek istiyorsunuz? Her zaman açığım.
          </p>
          <a
            href="mailto:enescetinmehmet14@gmail.com"
            class="mt-4 inline-flex items-center gap-2 font-mono text-copper hover:text-copper-light text-sm font-semibold"
          >
            enescetinmehmet14@gmail.com →
          </a>
