  <!-- İstemci Taraflı Proje Filtre Betiği -->
  <script is:inline>
    const filterButtons = document.querySelectorAll('.proj-filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.className =
            'proj-filter-btn px-3 py-1.5 text-xs rounded border transition-all border-line text-ink-muted hover:border-copper/60 hover:text-ink';
        });
        btn.className =
          'proj-filter-btn px-3 py-1.5 text-xs rounded border transition-all bg-copper text-bg border-copper font-medium shadow-[0_2px_10px_rgba(198,132,79,0.2)]';

        const selectedFilter = btn.getAttribute('data-filter') || 'Tümü';

        projectCards.forEach((card) => {
          const category = card.getAttribute('data-category') || '';
          if (selectedFilter === 'Tümü' || category === selectedFilter) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
