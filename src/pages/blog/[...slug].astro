---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Ortalama okuma süresi hesaplama (200 kelime / dakika)
const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));

const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<BaseLayout
  title={`${post.data.title} — Mehmet Enes Çetin`}
  description={post.data.description}
  image={post.data.coverImage}
  articleDate={post.data.date.toISOString()}
  isArticle={true}
>
  <!-- Schema.org BlogPosting JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "url": postUrl,
    "datePublished": post.data.date.toISOString(),
    "dateModified": post.data.date.toISOString(),
    "author": {
      "@type": "Person",
      "name": "Mehmet Enes Çetin",
      "url": "https://mehmetenescetin.com.tr"
    },
    "publisher": {
      "@type": "Person",
      "name": "Mehmet Enes Çetin"
    },
    ...(post.data.coverImage && { "image": post.data.coverImage }),
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": postUrl
    }
  })} />

  <div class="min-h-screen bg-bg text-ink">
    <header class="border-b border-line bg-bg-elevated/40 backdrop-blur sticky top-0 z-20">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
        <a
          href="/blog"
          class="text-sm text-ink-muted hover:text-copper flex items-center gap-2 transition-colors"
        >
          ← Tüm Yazılara Dön
        </a>
        <a href="/" class="font-serif text-lg font-semibold tracking-wide">
          E.<span class="text-copper">Çetin_</span>
        </a>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-12 lg:py-16">
      <div class="max-w-3xl mx-auto">
        <!-- Üst Bilgi Rozetleri -->
        <div class="flex flex-wrap items-center gap-3 text-xs text-ink-faint mb-4">
          <span class="px-2.5 py-1 rounded bg-copper/10 text-copper border border-copper/30 font-medium">
            {post.data.category}
          </span>
          <span>•</span>
          <span>
            {post.data.date.toLocaleDateString('tr-TR', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </span>
          <span>•</span>
          <span>{readingTime} dakika okuma süresi</span>
        </div>

        <h1 class="font-serif text-3xl sm:text-5xl font-medium tracking-tight text-ink leading-[1.15]">
          {post.data.title}
        </h1>

        <p class="mt-5 text-lg text-ink-muted leading-relaxed border-l-2 border-copper pl-4 italic">
          {post.data.description}
        </p>

        <!-- Yazar ve Sosyal Paylaşım -->
        <div class="my-8 pt-4 border-t border-line flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-copper/20 border border-copper text-copper font-serif flex items-center justify-center font-bold text-sm">
              ME
            </div>
            <div>
              <div class="text-sm font-medium text-ink">Mehmet Enes Çetin</div>
              <div class="text-xs text-ink-faint">Valtura Kurucusu &amp; Geliştirici</div>
            </div>
          </div>

          <div class="flex items-center gap-2 text-xs">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(postUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 border border-line rounded text-ink-muted hover:text-copper hover:border-copper transition-colors"
            >
              X (Twitter)
            </a>
            <button
              id="copy-btn"
              type="button"
              class="px-3 py-1.5 border border-line rounded text-ink-muted hover:text-copper hover:border-copper transition-colors"
            >
              Bağlantıyı Kopyala
            </button>
          </div>
        </div>

        <!-- İçindekiler Tablosu (TOC) -->
        {
          headings.length > 0 && (
            <div class="my-8 p-6 rounded-lg border border-line bg-bg-elevated/50">
              <div class="text-xs font-semibold text-copper uppercase tracking-wider mb-3">
                İçindekiler
              </div>
              <ul class="space-y-2 text-sm">
                {headings.map((h) => (
                  <li class={`${h.depth === 3 ? 'pl-4 text-xs' : 'font-medium'}`}>
                    <a
                      href={`#${h.slug}`}
                      class="text-ink-muted hover:text-copper transition-colors"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <!-- Makale İçeriği (Markdown) -->
        <article class="prose prose-invert max-w-none mt-10 leading-relaxed text-ink-muted">
          <Content />
        </article>

        <!-- Etiketler -->
        {
          post.data.tags.length > 0 && (
            <div class="mt-12 pt-6 border-t border-line flex flex-wrap items-center gap-2">
              <span class="text-xs text-copper font-medium">Etiketler:</span>
              {post.data.tags.map((t) => (
                <span class="text-xs px-2.5 py-1 rounded bg-bg-elevated border border-line text-ink-muted">
                  #{t}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </main>
  </div>

  <script is:inline>
    const copyBtn = document.getElementById('copy-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const originalText = copyBtn.textContent;
        copyBtn.textContent = 'Kopyalandı! ✓';
        copyBtn.style.borderColor = '#c6844f';
        copyBtn.style.color = '#c6844f';
        setTimeout(() => {
          copyBtn.textContent = originalText;
          copyBtn.style.borderColor = '';
          copyBtn.style.color = '';
        }, 2000);
      });
    }
  </script>
</BaseLayout>
