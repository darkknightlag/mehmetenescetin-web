---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const publishedPosts = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = ['Tümü', ...Array.from(new Set(publishedPosts.map((p) => p.data.category)))];
---

<BaseLayout
  title="Blog & Notlar — Mehmet Enes Çetin"
  description="Yapay zeka, bilgisayarlı görü, otomasyon araçları ve modern yazılım mimarisi üzerine teknik yazılar."
>
  <div class="min-h-screen bg-bg text-ink">
    <!-- Header -->
    <header class="border-b border-line bg-bg-elevated/70 backdrop-blur-md sticky top-0 z-40">
      <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
        <a
          href="/"
          class="text-sm text-ink-muted hover:text-copper flex items-center gap-2 transition-colors font-medium"
        >
          ← Ana Sayfaya Dön
        </a>
        <a href="/" class="font-serif text-lg font-semibold tracking-wide">
          E.<span class="text-copper">Çetin_</span>
        </a>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-16">
      <div class="max-w-2xl mb-12">
        <div class="text-xs font-mono uppercase tracking-widest text-copper mb-2">
          Deneyimler &amp; Teknik Notlar
        </div>
        <h1 class="font-serif text-4xl lg:text-5xl font-medium tracking-tight text-ink">
          Düşünceler &amp; Notlar
        </h1>
        <p class="mt-3 text-ink-muted text-base leading-relaxed font-light">
          Otomasyon araçları, gerçek zamanlı görüntü işleme sistemleri ve modern yazılım geliştirme süreçleri üzerine paylaşımlar.
        </p>
      </div>

      <!-- Arama ve Filtreleme Bölümü -->
      <div class="space-y-8">
        <div class="flex flex-col md:flex-row gap-4 justify-between items-stretch md:items-center">
          <div class="relative flex-1 max-w-md">
            <input
              type="text"
              id="search-input"
              placeholder="Başlık, özet veya etiket ara..."
              class="w-full px-4 py-2.5 bg-bg-elevated/80 border border-line rounded-lg text-sm text-ink placeholder:text-ink-faint focus:outline-none focus:border-copper transition-colors shadow-inner"
            />
          </div>

          <div class="flex flex-wrap gap-2" id="category-filters">
            {
              categories.map((cat, idx) => (
                <button
                  type="button"
                  data-category={cat}
                  class={`cat-btn px-3.5 py-1.5 text-xs rounded-lg border transition-all ${
                    idx === 0
                      ? 'bg-copper text-bg border-copper font-medium shadow-[0_2px_10px_rgba(198,132,79,0.2)] active-cat'
                      : 'border-line text-ink-muted hover:border-copper/60 hover:text-ink bg-bg-elevated/30'
                  }`}
                >
                  {cat}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Yazı Kartları -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="posts-container">
          {
            publishedPosts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                data-title={post.data.title.toLowerCase()}
                data-description={post.data.description.toLowerCase()}
                data-category={post.data.category}
                data-tags={post.data.tags.join(' ').toLowerCase()}
                class="post-card p-7 rounded-xl border border-line bg-bg-elevated/30 hover:border-copper/80 hover:bg-bg-elevated/60 transition-all flex flex-col justify-between group relative overflow-hidden"
              >
                <div>
                  <div class="flex items-center gap-3 text-xs text-ink-faint mb-3 font-mono">
                    <span class="text-copper font-medium">{post.data.category}</span>
                    <span>•</span>
                    <span>
                      {post.data.date.toLocaleDateString('tr-TR', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      })}
                    </span>
                  </div>
                  <h2 class="font-serif text-2xl font-medium text-ink group-hover:text-copper transition-colors leading-snug">
                    {post.data.title}
                  </h2>
                  <p class="mt-3 text-sm text-ink-muted line-clamp-3 leading-relaxed font-light">
                    {post.data.description}
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-line/50 flex flex-wrap gap-1.5">
                  {post.data.tags.map((tag) => (
                    <span class="text-xs px-2.5 py-0.5 rounded bg-line/40 text-ink-muted group-hover:text-ink transition-colors">
                      #{tag}
                    </span>
                  ))}
                </div>
              </a>
            ))
          }
        </div>

        <div
          id="no-results"
          class="hidden py-16 text-center border border-dashed border-line rounded-xl text-ink-faint"
        >
          Aradığınız kriterlere uygun yazı bulunamadı.
        </div>
      </div>
    </main>
  </div>

  <script is:inline>
    const searchInput = document.getElementById('search-input');
    const catButtons = document.querySelectorAll('.cat-btn');
    const postCards = document.querySelectorAll('.post-card');
    const noResults = document.getElementById('no-results');

    let currentCategory = 'Tümü';
    let currentSearch = '';

    function filterPosts() {
      let visibleCount = 0;

      postCards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-description') || '';
        const tags = card.getAttribute('data-tags') || '';
        const category = card.getAttribute('data-category') || '';

        const matchesCat = currentCategory === 'Tümü' || category === currentCategory;
        const matchesSearch =
          !currentSearch ||
          title.includes(currentSearch) ||
          desc.includes(currentSearch) ||
          tags.includes(currentSearch);

        if (matchesCat && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value.toLowerCase().trim();
        filterPosts();
      });
    }

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => {
          b.className =
            'cat-btn px-3.5 py-1.5 text-xs rounded-lg border transition-all border-line text-ink-muted hover:border-copper/60 hover:text-ink bg-bg-elevated/30';
        });
        btn.className =
          'cat-btn px-3.5 py-1.5 text-xs rounded-lg border transition-all bg-copper text-bg border-copper font-medium shadow-[0_2px_10px_rgba(198,132,79,0.2)] active-cat';
        currentCategory = btn.getAttribute('data-category') || 'Tümü';
        filterPosts();
      });
    });
  </script>
</BaseLayout>
